{
    "name": "MWAssistant",
    "version": "0.1.0",
    "author": [
        "Daniel Aharoni"
    ],
    "descriptionmsg": "mwassistant-desc",
    "type": "other",
    "requires": {
        "MediaWiki": ">=1.39.0"
    },
    "AutoloadNamespaces": {
        "MWAssistant\\": "includes/"
    },
    "TestAutoloadNamespaces": {
        "MWAssistant\\Tests\\": "tests/phpunit/"
    },
    "MessagesDirs": {
        "MWAssistant": [
            "i18n"
        ]
    },
    "ExtensionMessagesFiles": {
        "MWAssistantAlias": "MWAssistant.alias.php"
    },
    "ResourceModules": {
        "ext.mwassistant.chat": {
            "scripts": [
                "resources/mwassistant.chat.js"
            ],
            "styles": [
                "resources/mwassistant.chat.css"
            ],
            "messages": [
                "mwassistant-chat-conversation-error",
                "mwassistant-chat-copied",
                "mwassistant-chat-copy",
                "mwassistant-chat-copy-code",
                "mwassistant-chat-copy-error",
                "mwassistant-chat-error",
                "mwassistant-chat-error-closed",
                "mwassistant-chat-error-generic",
                "mwassistant-chat-error-malformed",
                "mwassistant-chat-error-too-large",
                "mwassistant-chat-error-unreachable",
                "mwassistant-chat-input-placeholder",
                "mwassistant-chat-loading-conversation",
                "mwassistant-chat-loading-sessions",
                "mwassistant-chat-new",
                "mwassistant-chat-send",
                "mwassistant-chat-session-delete",
                "mwassistant-chat-session-delete-confirm",
                "mwassistant-chat-session-delete-error",
                "mwassistant-chat-session-untitled",
                "mwassistant-chat-sessions-empty",
                "mwassistant-chat-sessions-error",
                "mwassistant-chat-thinking",
                "mwassistant-chat-tool-all",
                "mwassistant-chat-tool-category-members",
                "mwassistant-chat-tool-chars-total",
                "mwassistant-chat-tool-checking",
                "mwassistant-chat-tool-count",
                "mwassistant-chat-tool-elapsed",
                "mwassistant-chat-tool-find-pages-by-title",
                "mwassistant-chat-tool-get-categories",
                "mwassistant-chat-tool-get-page",
                "mwassistant-chat-tool-get-properties",
                "mwassistant-chat-tool-list-all",
                "mwassistant-chat-tool-list-pages",
                "mwassistant-chat-tool-no-matches",
                "mwassistant-chat-tool-no-matches-short",
                "mwassistant-chat-tool-no-query",
                "mwassistant-chat-tool-page-info",
                "mwassistant-chat-tool-preview-count",
                "mwassistant-chat-tool-preview-truncated",
                "mwassistant-chat-tool-result",
                "mwassistant-chat-tool-result-array",
                "mwassistant-chat-tool-result-json",
                "mwassistant-chat-tool-result-object",
                "mwassistant-chat-tool-result-smw",
                "mwassistant-chat-tool-results-found",
                "mwassistant-chat-tool-running",
                "mwassistant-chat-tool-score",
                "mwassistant-chat-tool-search-pages",
                "mwassistant-chat-tool-search-prefix",
                "mwassistant-chat-tool-smw-ask",
                "mwassistant-chat-tool-suggestions",
                "mwassistant-chat-tool-truncated",
                "mwassistant-chat-tool-unknown-page",
                "mwassistant-chat-tool-vector-search",
                "mwassistant-chat-tool-waiting",
                "mwassistant-chat-welcome"
            ],
            "dependencies": [
                "mediawiki.api",
                "mediawiki.jqueryMsg",
                "mediawiki.util"
            ],
            "targets": [
                "desktop",
                "mobile"
            ],
            "localBasePath": "",
            "remoteExtPath": "MWAssistant"
        },
        "ext.mwassistant.editor": {
            "scripts": [
                "resources/mwassistant.editor.js"
            ],
            "styles": [
                "resources/mwassistant.editor.css"
            ],
            "messages": [
                "mwassistant-chat-title",
                "mwassistant-editor-button",
                "mwassistant-editor-chat-unavailable",
                "mwassistant-editor-close",
                "mwassistant-editor-open-full-page"
            ],
            "dependencies": [
                "mediawiki.api",
                "mediawiki.util",
                "ext.mwassistant.chat"
            ],
            "targets": [
                "desktop"
            ],
            "localBasePath": "",
            "remoteExtPath": "MWAssistant"
        },
        "ext.mwassistant.global": {
            "scripts": [
                "resources/mwassistant.global.js"
            ],
            "styles": [
                "resources/mwassistant.global.css"
            ],
            "messages": [
                "mwassistant-search-icon-title",
                "mwassistant-search-icon-label"
            ],
            "dependencies": [
                "mediawiki.util",
                "jquery"
            ],
            "targets": [
                "desktop",
                "mobile"
            ],
            "localBasePath": "",
            "remoteExtPath": "MWAssistant"
        },
        "ext.mwassistant.embeddings": {
            "scripts": [
                "resources/mwassistant.embeddings.js"
            ],
            "styles": [
                "resources/mwassistant.embeddings.css"
            ],
            "dependencies": [
                "mediawiki.widgets",
                "oojs-ui-core",
                "oojs-ui-widgets"
            ],
            "targets": [
                "desktop",
                "mobile"
            ],
            "localBasePath": "",
            "remoteExtPath": "MWAssistant"
        }
    },
    "SpecialPages": {
        "MWAssistant": {
            "class": "MWAssistant\\Special\\SpecialMWAssistant"
        },
        "MWAssistantEmbeddings": {
            "class": "MWAssistant\\Special\\SpecialMWAssistantEmbeddings"
        },
        "MWAssistantStream": {
            "class": "MWAssistant\\Special\\SpecialMWAssistantStream"
        }
    },
    "Hooks": {
        "BeforePageDisplay": "MWAssistant\\Hooks\\MWAssistantHooks::onBeforePageDisplay",
        "PageSaveComplete": "MWAssistant\\Hooks\\AutoEmbeddingHooks::onPageSaveComplete",
        "PageDeleteComplete": "MWAssistant\\Hooks\\AutoEmbeddingHooks::onPageDeleteComplete",
        "PageMoveComplete": "MWAssistant\\Hooks\\AutoEmbeddingHooks::onPageMoveComplete"
    },
    "JobClasses": {
        "mwassistantUpdateEmbedding": "MWAssistant\\Jobs\\UpdateEmbeddingJob",
        "mwassistantDeleteEmbedding": "MWAssistant\\Jobs\\DeleteEmbeddingJob"
    },
    "AvailableRights": [
        "mwassistant-use"
    ],
    "RateLimits": {
        "mwassistant-chat": {
            "user": [
                30,
                60
            ]
        }
    },
    "APIModules": {
        "mwassistant-chat": "MWAssistant\\Api\\ApiMWAssistantChat",
        "mwassistant-sessions": "MWAssistant\\Api\\ApiMWAssistantSessions",
        "mwassistant-search": "MWAssistant\\Api\\ApiMWAssistantVectorSearch",
        "mwassistant-keyword-search": "MWAssistant\\Api\\ApiMWAssistantKeywordSearch",
        "mwassistant-smw": "MWAssistant\\Api\\ApiMWAssistantSMW",
        "mwassistant-check-access": "MWAssistant\\Api\\ApiMWAssistantCheckAccess",
        "mwassistant-page": "MWAssistant\\Api\\ApiMWAssistantPage",
        "mwassistant-page-info": "MWAssistant\\Api\\ApiMWAssistantPageInfo",
        "mwassistant-category-members": "MWAssistant\\Api\\ApiMWAssistantCategoryMembers",
        "mwassistant-find-pages-by-title": "MWAssistant\\Api\\ApiMWAssistantFindPagesByTitle"
    },
    "load_composer_autoloader": false,
    "url": "https://www.mediawiki.org/wiki/Extension:MWAssistant",
    "license-name": "GPL-3.0-or-later",
    "config": {
        "MWAssistantMCPBaseUrl": {
            "value": "http://localhost:8000"
        },
        "MWAssistantJWTMWToMCPSecret": {
            "value": ""
        },
        "MWAssistantJWTMCPToMWSecret": {
            "value": ""
        },
        "MWAssistantEnabled": {
            "value": true
        },
        "MWAssistantAutoEmbed": {
            "value": false
        },
        "MWAssistantJWTTTL": {
            "value": 30
        },
        "MWAssistantWikiId": {
            "value": "",
            "description": "Unique identifier for this wiki instance (required for multi-tenant MCP server)"
        },
        "MWAssistantWikiApiUrl": {
            "value": "",
            "description": "Publicly accessible API URL for this wiki (e.g. https://wiki.example.com/api.php)"
        },
        "MWAssistantEmbedSkipNamespaces": {
            "value": [2],
            "description": "Namespace IDs to skip when auto-embedding. Default skips NS_USER (2) since user pages are usually personal/scratch content. Set to [] to embed everything."
        },
        "MWAssistantEmbedTalkPages": {
            "value": false,
            "description": "If false (default), talk pages are skipped from auto-embedding. Set true on wikis where talk-page content is part of the searchable knowledge base."
        }
    },
    "manifest_version": 2
}